# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────
# Local dev (matches docker-compose.yml defaults):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interview_prep
# Free-tier hosted Postgres example (Supabase / Neon / Railway):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── JWT (auth pair: replace with a long random secret) ───────────────────
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── CORS ──────────────────────────────────────────────────────────────────
# Space-separated list parsed as JSON array in config.py
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── App ───────────────────────────────────────────────────────────────────
APP_ENV=development
